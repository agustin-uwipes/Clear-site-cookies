{
  "manifest_version": 3,
  "name": "Clear osTickets cookies",
  "version": "1.2",
  "permissions": [
    "cookies",
    "browsingData",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Clear osTickets cookies"
  },
  "background": {
    "service_worker": "background.js"
  }
}