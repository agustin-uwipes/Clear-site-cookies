{
  "manifest_version": 3,
  "name": "Clear osTickets cookies",
  "version": "1.5.1",
  "permissions": [
    "cookies",
    "browsingData",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Clear osTickets cookies",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "192": "icon192.png",
      "512": "icon512.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "192": "icon192.png",
    "512": "icon512.png"
  }
}